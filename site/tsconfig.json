{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleDetection": "force",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ES2023"
  },
  "include": ["docs", "theme", "rspress.config.ts"],
  "mdx": {
    "checkMdx": true
  }
}
